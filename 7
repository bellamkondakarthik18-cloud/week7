import 'package:flutter/material.dart';
import 'package:flutter/services.dart';

void main() => runApp(const MyApp());

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Form Validation',
      theme: ThemeData(
        colorSchemeSeed: Colors.indigo,
        useMaterial3: true,
        inputDecorationTheme: InputDecorationTheme(
          border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
        ),
      ),
      home: const RegistrationForm(),
    );
  }
}

// ---------------------------------------------------------------------------
// Reusable validators. Each returns null when valid, or an error message.
// ---------------------------------------------------------------------------
class Validators {
  static String? required(String? v, [String field = 'This field']) =>
      (v == null || v.trim().isEmpty) ? '$field is required' : null;

  static String? name(String? v) {
    final r = required(v, 'Name');
    if (r != null) return r;
    if (v!.trim().length < 3) return 'Name must be at least 3 characters';
    return null;
  }

  static String? email(String? v) {
    final r = required(v, 'Email');
    if (r != null) return r;
    if (!v!.contains('@') || !v.contains('.')) return 'Enter a valid email address';
    // Stricter check:
    final regex = RegExp(r'^[\w\.\-+]+@[\w\-]+(\.[\w\-]+)+$');
    if (!regex.hasMatch(v.trim())) return 'Enter a valid email address';
    return null;
  }

  static String? password(String? v) {
    final r = required(v, 'Password');
    if (r != null) return r;
    if (v!.length < 6) return 'Password must be at least 6 characters';
    if (!RegExp(r'[0-9!@#$%^&*(),.?":{}|<>_\-]').hasMatch(v)) {
      return 'Include at least one number or special character';
    }
    return null;
  }

  static String? Function(String?) confirmPassword(String Function() original) {
    return (v) {
      final r = required(v, 'Confirm password');
      if (r != null) return r;
      if (v != original()) return 'Passwords do not match';
      return null;
    };
  }

  static String? phone(String? v) {
    final r = required(v, 'Phone');
    if (r != null) return r;
    if (!RegExp(r'^[0-9]+$').hasMatch(v!)) return 'Digits only';
    if (v.length < 10) return 'Phone must be at least 10 digits';
    return null;
  }

  static String? age(String? v) {
    final r = required(v, 'Age');
    if (r != null) return r;
    final n = int.tryParse(v!);
    if (n == null) return 'Enter a whole number';
    if (n <= 0 || n > 120) return 'Age must be between 1 and 120';
    return null;
  }
}

// ---------------------------------------------------------------------------
// The form
// ---------------------------------------------------------------------------
class RegistrationForm extends StatefulWidget {
  const RegistrationForm({super.key});

  @override
  State<RegistrationForm> createState() => _RegistrationFormState();
}

class _RegistrationFormState extends State<RegistrationForm> {
  // 1. Key that gives access to FormState (validate / save / reset)
  final _formKey = GlobalKey<FormState>();

  // Controllers (optional, but handy for reading values / cross-field checks)
  final _nameCtrl = TextEditingController();
  final _emailCtrl = TextEditingController();
  final _phoneCtrl = TextEditingController();
  final _ageCtrl = TextEditingController();
  final _passCtrl = TextEditingController();
  final _confirmCtrl = TextEditingController();

  // Focus nodes for keyboard "next" navigation and focusing the first error
  final _nameFocus = FocusNode();
  final _emailFocus = FocusNode();
  final _phoneFocus = FocusNode();
  final _ageFocus = FocusNode();
  final _passFocus = FocusNode();
  final _confirmFocus = FocusNode();

  String? _country;
  String? _gender;
  bool _newsletter = true; // Switch: plain state, not validated
  bool _simulateError = false;
  bool _obscure = true;
  bool _submitting = false;
  AutovalidateMode _autoMode = AutovalidateMode.disabled;

  @override
  void dispose() {
    for (final c in [_nameCtrl, _emailCtrl, _phoneCtrl, _ageCtrl, _passCtrl, _confirmCtrl]) {
      c.dispose();
    }
    for (final f in [_nameFocus, _emailFocus, _phoneFocus, _ageFocus, _passFocus, _confirmFocus]) {
      f.dispose();
    }
    super.dispose();
  }

  /// Focus management: find the first field (top to bottom) whose validator fails.
  void _focusFirstInvalid() {
    final checks = <(FocusNode, String? Function())>[
      (_nameFocus, () => Validators.name(_nameCtrl.text)),
      (_emailFocus, () => Validators.email(_emailCtrl.text)),
      (_phoneFocus, () => Validators.phone(_phoneCtrl.text)),
      (_ageFocus, () => Validators.age(_ageCtrl.text)),
      (_passFocus, () => Validators.password(_passCtrl.text)),
      (_confirmFocus, () => Validators.confirmPassword(() => _passCtrl.text)(_confirmCtrl.text)),
    ];
    for (final (node, check) in checks) {
      if (check() != null) {
        FocusScope.of(context).requestFocus(node);
        return;
      }
    }
  }

  Future<void> _submit() async {
    // Once the user has tried to submit, validate live as they fix errors.
    setState(() => _autoMode = AutovalidateMode.onUserInteraction);

    // 4. validate() runs every validator and shows inline errors
    final isValid = _formKey.currentState?.validate() ?? false;
    if (!isValid) {
      _focusFirstInvalid();
      return;
    }

    _formKey.currentState!.save(); // triggers onSaved of each field
    setState(() => _submitting = true);

    try {
      await Future.delayed(const Duration(seconds: 1)); // fake network call
      if (_simulateError) throw Exception('Network unreachable');

      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Welcome, ${_nameCtrl.text.trim()}!')),
      );
      _reset();
    } catch (e) {
      // Global error: not tied to a single field
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          backgroundColor: Theme.of(context).colorScheme.error,
          content: Text('Submission failed: $e'),
          action: SnackBarAction(label: 'RETRY', textColor: Colors.white, onPressed: _submit),
        ),
      );
    } finally {
      if (mounted) setState(() => _submitting = false);
    }
  }

  void _reset() {
    _formKey.currentState?.reset();
    for (final c in [_nameCtrl, _emailCtrl, _phoneCtrl, _ageCtrl, _passCtrl, _confirmCtrl]) {
      c.clear();
    }
    setState(() {
      _country = null;
      _gender = null;
      _autoMode = AutovalidateMode.disabled;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Registration Form')),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Form(
          key: _formKey,
          autovalidateMode: _autoMode,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              // Name
              TextFormField(
                controller: _nameCtrl,
                focusNode: _nameFocus,
                textInputAction: TextInputAction.next,
                textCapitalization: TextCapitalization.words,
                decoration: const InputDecoration(
                  labelText: 'Full name',
                  prefixIcon: Icon(Icons.person),
                ),
                validator: Validators.name,
                onFieldSubmitted: (_) => _emailFocus.requestFocus(),
              ),
              const SizedBox(height: 16),

              // Email
              TextFormField(
                controller: _emailCtrl,
                focusNode: _emailFocus,
                keyboardType: TextInputType.emailAddress,
                textInputAction: TextInputAction.next,
                decoration: const InputDecoration(
                  labelText: 'Email',
                  prefixIcon: Icon(Icons.email),
                ),
                validator: Validators.email,
                onFieldSubmitted: (_) => _phoneFocus.requestFocus(),
              ),
              const SizedBox(height: 16),

              // Phone (digits only keyboard + input formatter)
              TextFormField(
                controller: _phoneCtrl,
                focusNode: _phoneFocus,
                keyboardType: TextInputType.phone,
                textInputAction: TextInputAction.next,
                inputFormatters: [FilteringTextInputFormatter.digitsOnly],
                maxLength: 15,
                decoration: const InputDecoration(
                  labelText: 'Phone',
                  prefixIcon: Icon(Icons.phone),
                ),
                validator: Validators.phone,
                onFieldSubmitted: (_) => _ageFocus.requestFocus(),
              ),
              const SizedBox(height: 8),

              // Age
              TextFormField(
                controller: _ageCtrl,
                focusNode: _ageFocus,
                keyboardType: TextInputType.number,
                textInputAction: TextInputAction.next,
                inputFormatters: [FilteringTextInputFormatter.digitsOnly],
                decoration: const InputDecoration(
                  labelText: 'Age',
                  prefixIcon: Icon(Icons.cake),
                ),
                validator: Validators.age,
                onFieldSubmitted: (_) => _passFocus.requestFocus(),
              ),
              const SizedBox(height: 16),

              // Dropdown
              DropdownButtonFormField<String>(
                value: _country,
                decoration: const InputDecoration(
                  labelText: 'Country',
                  prefixIcon: Icon(Icons.public),
                ),
                items: const ['India', 'USA', 'UK', 'Germany']
                    .map((c) => DropdownMenuItem(value: c, child: Text(c)))
                    .toList(),
                onChanged: (v) => setState(() => _country = v),
                validator: (v) => v == null ? 'Please select a country' : null,
              ),
              const SizedBox(height: 16),

              // Gender: a custom FormField wrapping SegmentedButton
              // (wrap any non-text widget in FormField to give it validation)
              FormField<String>(
                initialValue: _gender,
                validator: (v) => v == null ? 'Please select a gender' : null,
                builder: (state) => Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    SegmentedButton<String>(
                      emptySelectionAllowed: true,
                      segments: const [
                        ButtonSegment(value: 'Male', label: Text('Male')),
                        ButtonSegment(value: 'Female', label: Text('Female')),
                        ButtonSegment(value: 'Other', label: Text('Other')),
                      ],
                      selected: state.value == null ? {} : {state.value!},
                      onSelectionChanged: (s) {
                        final v = s.isEmpty ? null : s.first;
                        state.didChange(v);
                        _gender = v;
                      },
                    ),
                    if (state.hasError)
                      Padding(
                        padding: const EdgeInsets.only(top: 6, left: 12),
                        child: Text(
                          state.errorText!,
                          style: TextStyle(
                            color: Theme.of(context).colorScheme.error,
                            fontSize: 12,
                          ),
                        ),
                      ),
                  ],
                ),
              ),
              const SizedBox(height: 16),

              // Password
              TextFormField(
                controller: _passCtrl,
                focusNode: _passFocus,
                obscureText: _obscure,
                textInputAction: TextInputAction.next,
                decoration: InputDecoration(
                  labelText: 'Password',
                  prefixIcon: const Icon(Icons.lock),
                  suffixIcon: IconButton(
                    icon: Icon(_obscure ? Icons.visibility : Icons.visibility_off),
                    onPressed: () => setState(() => _obscure = !_obscure),
                  ),
                ),
                validator: Validators.password,
                onFieldSubmitted: (_) => _confirmFocus.requestFocus(),
              ),
              const SizedBox(height: 16),

              // Confirm password: compares against the other controller
              TextFormField(
                controller: _confirmCtrl,
                focusNode: _confirmFocus,
                obscureText: _obscure,
                textInputAction: TextInputAction.done,
                decoration: const InputDecoration(
                  labelText: 'Confirm password',
                  prefixIcon: Icon(Icons.lock_outline),
                ),
                validator: Validators.confirmPassword(() => _passCtrl.text),
                onFieldSubmitted: (_) => _submit(),
              ),
              const SizedBox(height: 16),

              // Switch (manual state, no validation needed)
              SwitchListTile(
                contentPadding: EdgeInsets.zero,
                title: const Text('Subscribe to newsletter'),
                value: _newsletter,
                onChanged: (v) => setState(() => _newsletter = v),
              ),

              // Checkbox that must be ticked: FormField<bool> gives it a validator
              FormField<bool>(
                initialValue: false,
                validator: (v) => v == true ? null : 'You must accept the terms',
                builder: (state) => Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    CheckboxListTile(
                      contentPadding: EdgeInsets.zero,
                      controlAffinity: ListTileControlAffinity.leading,
                      title: const Text('I accept the terms & conditions'),
                      value: state.value ?? false,
                      onChanged: state.didChange,
                    ),
                    if (state.hasError)
                      Padding(
                        padding: const EdgeInsets.only(left: 12),
                        child: Text(
                          state.errorText!,
                          style: TextStyle(
                            color: Theme.of(context).colorScheme.error,
                            fontSize: 12,
                          ),
                        ),
                      ),
                  ],
                ),
              ),

              // Demo toggle for the global error path
              SwitchListTile(
                contentPadding: EdgeInsets.zero,
                title: const Text('Simulate network error'),
                value: _simulateError,
                onChanged: (v) => setState(() => _simulateError = v),
              ),
              const SizedBox(height: 16),

              // Buttons
              Row(
                children: [
                  Expanded(
                    child: FilledButton(
                      onPressed: _submitting ? null : _submit,
                      child: _submitting
                          ? const SizedBox(
                              height: 20,
                              width: 20,
                              child: CircularProgressIndicator(strokeWidth: 2),
                            )
                          : const Text('Register'),
                    ),
                  ),
                  const SizedBox(width: 12),
                  OutlinedButton(onPressed: _reset, child: const Text('Reset')),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }
}
